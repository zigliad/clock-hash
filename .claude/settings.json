{
  "permissions": {
    "allow": [
      "Bash(*)",
      "mcp__linear__*",
      "mcp__claude_ai_Linear__*"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "echo $CLAUDE_TOOL_INPUT | grep -qE '\\.(jsx?|tsx?|css)' && npx prettier --write $(echo $CLAUDE_TOOL_INPUT | grep -oE '[^ ]+\\.(jsx?|tsx?|css)' | head -1) 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "npm test --passWithNoTests 2>&1 | tail -5"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo $CLAUDE_TOOL_INPUT | grep -q 'git commit' && npm run lint && npx semgrep --config=auto src/ --quiet || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/merge-gate.sh"
          }
        ]
      }
    ]
  }
}
